{
  "$schema": "https://schemas.vnstudio.dev/specs-v1.0.0/ui-screen.schema.json",
  "id": "backlog",
  "kind": "custom",
  "focus_start": "log",
  "elements": [
    {
      "id": "lbl_title",
      "type": "label",
      "text": "Log",
      "position": [
        0.5,
        0.08
      ],
      "align": "center"
    },
    {
      "id": "log",
      "type": "backlog_list",
      "max_items": 200,
      "position": [
        0.5,
        0.5
      ],
      "size": [
        1400,
        760
      ]
    },
    {
      "id": "btn_back",
      "type": "button",
      "text": "Back",
      "actions": [
        {
          "do": "back"
        }
      ],
      "position": [
        0.5,
        0.92
      ]
    }
  ]
}
