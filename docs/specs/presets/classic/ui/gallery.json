{
  "$schema": "https://schemas.vnstudio.dev/1/ui-screen.schema.json",
  "id": "gallery",
  "kind": "gallery",
  "focus_start": "tabs",
  "on_open": [
    {
      "do": "hide",
      "target": "grid_endings"
    },
    {
      "do": "hide",
      "target": "grid_images"
    },
    {
      "do": "hide",
      "target": "grid_music"
    },
    {
      "do": "show",
      "target": "grid_endings",
      "if": [
        {
          "variable": "sys.ui.gallery_endings",
          "operator": "equals",
          "value": true
        }
      ]
    },
    {
      "do": "show",
      "target": "grid_images",
      "if": [
        {
          "variable": "sys.ui.gallery_images",
          "operator": "equals",
          "value": true
        },
        {
          "variable": "sys.ui.gallery_endings",
          "operator": "equals",
          "value": false
        }
      ]
    },
    {
      "do": "show",
      "target": "grid_music",
      "if": [
        {
          "variable": "sys.ui.gallery_music",
          "operator": "equals",
          "value": true
        },
        {
          "variable": "sys.ui.gallery_endings",
          "operator": "equals",
          "value": false
        },
        {
          "variable": "sys.ui.gallery_images",
          "operator": "equals",
          "value": false
        }
      ]
    }
  ],
  "elements": [
    {
      "id": "lbl_title",
      "type": "label",
      "text": "Gallery",
      "position": [
        0.5,
        0.08
      ],
      "align": "center"
    },
    {
      "id": "tabs",
      "type": "container",
      "layout": "row",
      "spacing": 12,
      "position": [
        0.5,
        0.18
      ],
      "children": [
        {
          "id": "btn_endings",
          "type": "button",
          "text": "Endings",
          "actions": [
            {
              "do": "show",
              "target": "grid_endings"
            },
            {
              "do": "hide",
              "target": "grid_images"
            },
            {
              "do": "hide",
              "target": "grid_music"
            }
          ],
          "visible_if": [
            {
              "variable": "sys.ui.gallery_endings",
              "operator": "equals",
              "value": true
            }
          ]
        },
        {
          "id": "btn_images",
          "type": "button",
          "text": "Images",
          "actions": [
            {
              "do": "hide",
              "target": "grid_endings"
            },
            {
              "do": "show",
              "target": "grid_images"
            },
            {
              "do": "hide",
              "target": "grid_music"
            }
          ],
          "visible_if": [
            {
              "variable": "sys.ui.gallery_images",
              "operator": "equals",
              "value": true
            }
          ]
        },
        {
          "id": "btn_music",
          "type": "button",
          "text": "Music",
          "actions": [
            {
              "do": "hide",
              "target": "grid_endings"
            },
            {
              "do": "hide",
              "target": "grid_images"
            },
            {
              "do": "show",
              "target": "grid_music"
            }
          ],
          "visible_if": [
            {
              "variable": "sys.ui.gallery_music",
              "operator": "equals",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "grid_endings",
      "type": "gallery_grid",
      "source": "endings",
      "columns": 4,
      "position": [
        0.5,
        0.55
      ]
    },
    {
      "id": "grid_images",
      "type": "gallery_grid",
      "source": "images",
      "columns": 4,
      "position": [
        0.5,
        0.55
      ]
    },
    {
      "id": "grid_music",
      "type": "gallery_grid",
      "source": "music",
      "columns": 2,
      "position": [
        0.5,
        0.55
      ]
    },
    {
      "id": "btn_back",
      "type": "button",
      "text": "Back",
      "actions": [
        {
          "do": "back"
        }
      ],
      "position": [
        0.5,
        0.92
      ]
    }
  ]
}
