{
  "$schema": "https://schemas.vnstudio.dev/1/ui-screen.schema.json",
  "id": "pause",
  "kind": "pause",
  "modal": true,
  "focus_start": "menu",
  "elements": [
    {
      "id": "lbl_title",
      "type": "label",
      "text": "Paused",
      "position": [
        0.5,
        0.2
      ],
      "align": "center"
    },
    {
      "id": "menu",
      "type": "container",
      "position": [
        0.5,
        0.55
      ],
      "layout": "column",
      "spacing": 14,
      "children": [
        {
          "id": "btn_resume",
          "type": "button",
          "text": "Resume",
          "actions": [
            {
              "do": "back"
            }
          ]
        },
        {
          "id": "btn_save",
          "type": "button",
          "text": "Save",
          "actions": [
            {
              "do": "open_screen",
              "screen": "save"
            }
          ]
        },
        {
          "id": "btn_load",
          "type": "button",
          "text": "Load",
          "actions": [
            {
              "do": "open_screen",
              "screen": "load"
            }
          ]
        },
        {
          "id": "btn_settings",
          "type": "button",
          "text": "Settings",
          "actions": [
            {
              "do": "open_screen",
              "screen": "settings"
            }
          ]
        },
        {
          "id": "btn_title",
          "type": "button",
          "text": "Return to title",
          "actions": [
            {
              "do": "return_to_title",
              "confirm": true
            }
          ]
        },
        {
          "id": "btn_quit",
          "type": "button",
          "text": "Quit",
          "actions": [
            {
              "do": "quit",
              "confirm": true
            }
          ],
          "visible_if": [
            {
              "variable": "sys.ui.platform",
              "operator": "not_equals",
              "value": "web"
            }
          ]
        }
      ]
    }
  ]
}
