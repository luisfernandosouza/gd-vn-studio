{
  "$schema": "https://schemas.vnstudio.dev/specs-v1.0.0/conformance.schema.json",
  "title": "Conversão e formatação de números",
  "covers": [
    "DM §6.1.1 (concat)",
    "DM §9",
    "Plugin SDK §9.1",
    "RT §12.1"
  ],
  "cases": [
    {
      "id": "concat_int_big",
      "description": "concat de inteiro grande sem separador",
      "kind": "text",
      "mode": "concat",
      "value": 1234567,
      "expect": {
        "text": "1234567"
      }
    },
    {
      "id": "concat_number_whole",
      "description": "concat de number com parte fracionária zero",
      "kind": "text",
      "mode": "concat",
      "value": {
        "type": "number",
        "value": 1234567.0
      },
      "expect": {
        "text": "1234567"
      }
    },
    {
      "id": "interp_en",
      "description": "inglês: vírgula no milhar, ponto decimal",
      "kind": "text",
      "mode": "interpolation",
      "value": {
        "type": "number",
        "value": 1234567.5
      },
      "locale": "en",
      "expect": {
        "text": "1,234,567.5"
      }
    },
    {
      "id": "interp_pt",
      "description": "pt-BR: ponto no milhar, vírgula decimal",
      "kind": "text",
      "mode": "interpolation",
      "value": {
        "type": "number",
        "value": 1234567.5
      },
      "locale": "pt-BR",
      "expect": {
        "text": "1.234.567,5"
      }
    },
    {
      "id": "interp_de_int",
      "description": "alemão: inteiro de 4 dígitos agrupado",
      "kind": "text",
      "mode": "interpolation",
      "value": 1234,
      "locale": "de",
      "expect": {
        "text": "1.234"
      }
    },
    {
      "id": "interp_es_4",
      "description": "espanhol: 4 dígitos sem separador",
      "kind": "text",
      "mode": "interpolation",
      "value": 1234,
      "locale": "es",
      "expect": {
        "text": "1234"
      }
    },
    {
      "id": "interp_es_5",
      "description": "espanhol: 5 dígitos com separador",
      "kind": "text",
      "mode": "interpolation",
      "value": 12345,
      "locale": "es",
      "expect": {
        "text": "12.345"
      }
    },
    {
      "id": "interp_fr",
      "description": "francês: espaço fino inseparável no milhar",
      "kind": "text",
      "mode": "interpolation",
      "value": {
        "type": "number",
        "value": 1234567.5
      },
      "locale": "fr",
      "expect": {
        "text": "1 234 567,5"
      }
    },
    {
      "id": "interp_ja",
      "description": "japonês usa a tabela do inglês",
      "kind": "text",
      "mode": "interpolation",
      "value": {
        "type": "number",
        "value": 9876.25
      },
      "locale": "ja",
      "expect": {
        "text": "9,876.25"
      }
    },
    {
      "id": "interp_zh_hant",
      "description": "chinês tradicional usa a tabela do inglês",
      "kind": "text",
      "mode": "interpolation",
      "value": 1000000,
      "locale": "zh-Hant",
      "expect": {
        "text": "1,000,000"
      }
    },
    {
      "id": "interp_fallback",
      "description": "idioma fora da tabela (pt-PT) usa o inglês",
      "kind": "text",
      "mode": "interpolation",
      "value": {
        "type": "number",
        "value": 1234.5
      },
      "locale": "pt-PT",
      "expect": {
        "text": "1,234.5"
      }
    },
    {
      "id": "interp_round_decimal",
      "description": "arredonda sobre a representação decimal mais curta (1.005 → 1.01)",
      "kind": "text",
      "mode": "interpolation",
      "value": {
        "type": "number",
        "value": 1.005
      },
      "locale": "en",
      "expect": {
        "text": "1.01"
      }
    },
    {
      "id": "interp_round_2675",
      "description": "2.675 → 2.68",
      "kind": "text",
      "mode": "interpolation",
      "value": {
        "type": "number",
        "value": 2.675
      },
      "locale": "en",
      "expect": {
        "text": "2.68"
      }
    },
    {
      "id": "interp_strip_zeros",
      "description": "sem zeros à direita (2.50 → 2.5)",
      "kind": "text",
      "mode": "interpolation",
      "value": {
        "type": "number",
        "value": 2.5
      },
      "locale": "it",
      "expect": {
        "text": "2,5"
      }
    },
    {
      "id": "interp_negative",
      "description": "negativo com milhar",
      "kind": "text",
      "mode": "interpolation",
      "value": -1234567,
      "locale": "pt-BR",
      "expect": {
        "text": "-1.234.567"
      }
    },
    {
      "id": "interp_neg_zero",
      "description": "negativo que arredonda para zero sai sem sinal",
      "kind": "text",
      "mode": "interpolation",
      "value": {
        "type": "number",
        "value": -0.004
      },
      "locale": "en",
      "expect": {
        "text": "0"
      }
    },
    {
      "id": "interp_bool",
      "description": "booleano sai como true/false em qualquer idioma",
      "kind": "text",
      "mode": "interpolation",
      "value": true,
      "locale": "pt-BR",
      "expect": {
        "text": "true"
      }
    },
    {
      "id": "record_time_ms_minutos",
      "description": "time_ms: 1 min 2,345 s em pt-BR → 1:02,34 (centésimos truncados)",
      "kind": "text",
      "mode": "record",
      "format": "time_ms",
      "value": 62345,
      "locale": "pt-BR",
      "expect": {
        "text": "1:02,34"
      }
    },
    {
      "id": "record_time_ms_horas",
      "description": "time_ms acima de uma hora",
      "kind": "text",
      "mode": "record",
      "format": "time_ms",
      "value": 3725678,
      "locale": "en",
      "expect": {
        "text": "1:02:05.67"
      }
    },
    {
      "id": "record_time_ms_zero",
      "description": "time_ms zero",
      "kind": "text",
      "mode": "record",
      "format": "time_ms",
      "value": 0,
      "locale": "en",
      "expect": {
        "text": "0:00.00"
      }
    },
    {
      "id": "record_integer_de",
      "description": "integer com milhar em alemão",
      "kind": "text",
      "mode": "record",
      "format": "integer",
      "value": 12345,
      "locale": "de",
      "expect": {
        "text": "12.345"
      }
    },
    {
      "id": "override_idioma_fora_da_tabela",
      "description": "settings.number_formats para ru (fora da tabela): vírgula decimal e espaço inseparável",
      "kind": "text",
      "mode": "interpolation",
      "value": {
        "type": "number",
        "value": 1234567.5
      },
      "locale": "ru",
      "number_formats": {
        "ru": {
          "decimal": ",",
          "group": " "
        }
      },
      "expect": {
        "text": "1 234 567,5"
      }
    },
    {
      "id": "override_sem_milhar",
      "description": "number_formats com group vazio",
      "kind": "text",
      "mode": "interpolation",
      "value": 1234567,
      "locale": "pl",
      "number_formats": {
        "pl": {
          "decimal": ",",
          "group": ""
        }
      },
      "expect": {
        "text": "1234567"
      }
    },
    {
      "id": "override_sobre_a_tabela",
      "description": "number_formats tem precedência sobre a tabela (de com espaço fino)",
      "kind": "text",
      "mode": "interpolation",
      "value": {
        "type": "number",
        "value": 12345.25
      },
      "locale": "de",
      "number_formats": {
        "de": {
          "decimal": ",",
          "group": " ",
          "min_grouping": 5
        }
      },
      "expect": {
        "text": "12 345,25"
      }
    },
    {
      "id": "sem_override_ko",
      "description": "ko sem number_formats usa o inglês",
      "kind": "text",
      "mode": "interpolation",
      "value": {
        "type": "number",
        "value": 1234567.5
      },
      "locale": "ko",
      "expect": {
        "text": "1,234,567.5"
      }
    }
  ]
}