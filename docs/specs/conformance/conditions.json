{
  "$schema": "https://schemas.vnstudio.dev/specs-v1.0.0/conformance.schema.json",
  "title": "Condições",
  "covers": [
    "DM §5",
    "DM §5.1",
    "DM §5.2"
  ],
  "cases": [
    {
      "id": "empty_list",
      "description": "lista vazia é verdadeira",
      "kind": "condition",
      "variables": {
        "global.money": {
          "type": "integer",
          "value": 30,
          "default": 0
        },
        "global.mood": {
          "type": "enum",
          "value": "happy",
          "default": "happy"
        },
        "global.name": {
          "type": "string",
          "value": "Alice Souza",
          "default": ""
        },
        "global.ratio": {
          "type": "number",
          "value": 1.0,
          "default": 0.5
        },
        "global.flag": {
          "type": "boolean",
          "value": false,
          "default": false
        }
      },
      "conditions": [],
      "expect": {
        "value": true
      }
    },
    {
      "id": "list_is_all",
      "description": "lista equivale a all",
      "kind": "condition",
      "variables": {
        "global.money": {
          "type": "integer",
          "value": 30,
          "default": 0
        },
        "global.mood": {
          "type": "enum",
          "value": "happy",
          "default": "happy"
        },
        "global.name": {
          "type": "string",
          "value": "Alice Souza",
          "default": ""
        },
        "global.ratio": {
          "type": "number",
          "value": 1.0,
          "default": 0.5
        },
        "global.flag": {
          "type": "boolean",
          "value": false,
          "default": false
        }
      },
      "conditions": [
        {
          "variable": "global.money",
          "operator": "greater_than",
          "value": 10
        },
        {
          "variable": "global.flag",
          "operator": "equals",
          "value": true
        }
      ],
      "expect": {
        "value": false
      }
    },
    {
      "id": "any_not",
      "description": "any e not",
      "kind": "condition",
      "variables": {
        "global.money": {
          "type": "integer",
          "value": 30,
          "default": 0
        },
        "global.mood": {
          "type": "enum",
          "value": "happy",
          "default": "happy"
        },
        "global.name": {
          "type": "string",
          "value": "Alice Souza",
          "default": ""
        },
        "global.ratio": {
          "type": "number",
          "value": 1.0,
          "default": 0.5
        },
        "global.flag": {
          "type": "boolean",
          "value": false,
          "default": false
        }
      },
      "conditions": {
        "any": [
          {
            "variable": "global.flag",
            "operator": "equals",
            "value": true
          },
          {
            "not": {
              "variable": "global.money",
              "operator": "less_than",
              "value": 5
            }
          }
        ]
      },
      "expect": {
        "value": true
      }
    },
