{
  "name": "@vnstudio/editor-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Editor SDK do Visual Novel Studio: API das Editor Extensions dos plugins (Plugin SDK §10)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
