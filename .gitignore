# Python (ferramentas das specs)
__pycache__/
*.pyc

# Estado local do Studio em projetos de jogo abertos daqui
.vnstudio/

# Cache do editor do Godot
.godot/

# Gerados por compile_bundle.py --godot (Runtime Spec §2.1, spec 09 §1)
runtime/vn_content/
runtime/vn_plugins/

# Bundles de teste gerados por runtime/tests/fixtures/generate.py (tarefa M0-08, spec 09 §1.1)
runtime/tests/fixtures/bundles/

# Projetos de desenvolvimento dos plugins oficiais (spec 09 §2)
plugins/*/addons/vn_runtime_sdk/
*.vnplugin
# ...mas a pasta .vnplugin/ (versão do Godot) vai para o Git; só local.json fica fora
!.vnplugin/
plugins/*/.vnplugin/local.json
plugins/*/vn_plugins/*/editor/node_modules/

# Node (Studio, CLI, Editor SDK)
node_modules/

# Cópias geradas de docs/specs/ por docs/specs/tools/sync_generated_copies.py (spec 09 §1, tarefa M0-03).
# Nunca vão para o Git nem são editadas à mão; a CI (generated-copies.yml) confere por hash.
runtime/vn_runtime/presets/
runtime/vn_runtime/licenses/
studio/src-tauri/resources/specs/
cli/schemas/
