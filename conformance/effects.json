{
  "$schema": "https://schemas.vnstudio.dev/1/conformance.schema.json",
  "title": "Efeitos e transações",
  "covers": [
    "DM §6.2",
    "RT §6.2"
  ],
  "cases": [
    {
      "id": "sequence_sees_previous",
      "description": "cada efeito enxerga o anterior",
      "kind": "effects",
      "variables": {
        "global.money": {
          "type": "integer",
          "value": 30,
          "default": 0,
          "constraints": {
            "min": 0,
            "max": 100,
            "on_overflow": "reject"
          }
        },
        "global.energy": {
          "type": "integer",
          "value": 8,
          "default": 10,
          "constraints": {
            "min": 0,
            "max": 10
          }
        },
        "global.speed": {
          "type": "number",
          "value": 1.5,
          "default": 1.0
        },
        "global.flag": {
          "type": "boolean",
          "value": false,
          "default": false
        },
        "global.mood": {
          "type": "enum",
          "value": "happy",
          "default": "happy",
          "constraints": {
            "values": [
              "happy",
              "sad"
            ]
          }
        },
        "global.nick": {
          "type": "string",
          "value": "Al",
          "default": "",
          "constraints": {
            "max_length": 5
          }
        }
      },
      "effects": [
        {
          "op": "add",
          "variable": "global.money",
          "value": 10
        },
        {
          "op": "set",
          "variable": "global.energy",
          "value": {
            "fn": "div",
            "args": [
              {
                "var": "global.money"
              },
              10
            ]
          }
        }
      ],
      "expect": {
        "changes": [
          {
            "variable": "global.money",
            "old": 30,
            "new": 40
          },
          {
            "variable": "global.energy",
            "old": 8,
            "new": 4
          }
        ]
      }
    },
